 jobs:
   check:
     runs-on: ubuntu-latest
@@ -8,12 +8,39 @@ jobs:
       - uses: actions/setup-python@v5
         with:
           python-version: '3.12'
-      - run: python -m pip install -r requirements.txt
-      - run: python scripts/check.py
-      - run: python scripts/test_learning.py
       - uses: actions/setup-node@v4
         with:
           node-version: '22'
+      - run: python -m pip install -r requirements.txt
+      - run: python scripts/check.py
       - run: node scripts/test_learning.cjs
       - run: python -m mkdocs build --strict
       - run: python scripts/check_site.py
+
+  # Runs every example, exercise and quiz against the real browser Linux.
+  browser:
+    runs-on: ubuntu-latest
+    needs: check
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - run: python -m pip install -r requirements.txt
+      - run: python -m mkdocs build --strict
+      - run: npm install --no-save playwright@1.56.0 && npx playwright install --with-deps chromium
+      - name: Serve site under the Pages base path and run the browser test
+        run: |
+          mkdir -p /tmp/serve && ln -s "$PWD/site" /tmp/serve/its4dh-practicals
+          (cd /tmp/serve && python -m http.server 8000 --bind 127.0.0.1 &)
+          sleep 1
+          PREVIEW_URL=http://127.0.0.1:8000/its4dh-practicals/ TEST_ARTIFACT_DIR=/tmp/screens node scripts/test_course_browser.cjs
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: screenshots
+          path: /tmp/screens/*.png
+          if-no-files-found: ignore
